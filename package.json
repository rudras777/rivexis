{
  "name": "rivexis",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/api/cloudflare"
  ],
  "scripts": {
    "build": "node scripts/cloudflare-workers-build.mjs",
    "deploy": "npm --workspace @rivexis/web run deploy",
    "dev:web": "npm --workspace @rivexis/web run dev",
    "build:web": "npm --workspace @rivexis/web run build",
    "typecheck:web": "npm --workspace @rivexis/web run typecheck",
    "lint:web": "npm --workspace @rivexis/web run lint",
    "typecheck:api-edge": "npm --workspace @rivexis/api-edge run typecheck",
    "test:defi": "node --test supabase/functions/rivexis-api/defi*.test.mjs",
    "test:api-edge": "node --test supabase/functions/rivexis-api/analysis.test.mjs supabase/functions/rivexis-api/decision-report.test.mjs supabase/functions/rivexis-api/report-pdf.test.mjs supabase/functions/rivexis-api/membership.test.mjs supabase/functions/rivexis-api/role.test.mjs supabase/functions/rivexis-api/organization-workspace.test.mjs supabase/functions/rivexis-alert-dispatch/delivery.test.mjs",
    "types:api-edge": "npm --workspace @rivexis/api-edge run cf-typegen",
    "test:api": "cd apps/api && pytest",
    "verify": "bash scripts/verify.sh",
    "check:frontend-ast": "node scripts/check_frontend_ast.js",
    "test:e2e": "npm --workspace @rivexis/web run test:e2e",
    "test:a11y": "npm --workspace @rivexis/web run test:a11y"
  },
  "overrides": {
    "wrangler": "4.148.0",
    "sharp": "0.35.5",
    "source-map-js": "1.2.2"
  },
  "devDependencies": {
    "source-map-js": "1.2.2"
  }
}
