{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rivexis-web",
  "account_id": "0b22778ba197266a58dd26eeef0334a8",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "apps/web/dist/server/index.js",
  "no_bundle": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.js", "**/*.mjs"]
    }
  ],
  "preview_urls": false,
  "assets": {
    "directory": "apps/web/dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true,
    "redact_query_string": true
  }
}
