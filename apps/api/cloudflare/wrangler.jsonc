{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "rivexis-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "containers": [
    {
      "name": "rivexis-api",
      "class_name": "RivexisApiContainer",
      "image": "../Dockerfile",
      "image_build_context": "..",
      "instance_type": "lite",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "RIVEXIS_API_CONTAINER",
        "class_name": "RivexisApiContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RivexisApiContainer"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
