# Local UI preview only. npm run dev:web also enforces these safe defaults.
# Copy to apps/web/.env.local; never copy production users, sessions or service keys.
NEXT_PUBLIC_RIVEXIS_API_URL=same-origin
RIVEXIS_E2E_BLOCK_EXTERNAL_UPSTREAM=1
# NEXT_PUBLIC_ values are public browser configuration, never credentials.
# Authenticated local workflows use the existing isolated Playwright fixtures.
# Full local Supabase reconstruction remains a separately tracked migration task.
