RIVEXIS_ENV=development
# Production requires a unique secret of at least 32 characters.
RIVEXIS_AUTH_SECRET=replace-with-a-long-random-secret
DATABASE_URL=sqlite:///./rivexis.db
# Dedicated PostgreSQL migration/owner connection for the one-shot migration job.
# Never inject this value into API/worker runtime containers. Keep DATABASE_URL on the restricted runtime role.
RIVEXIS_MIGRATION_DATABASE_URL=
# Alert worker uses a separate non-superuser BYPASSRLS role restricted to SELECT/UPDATE on alerts.
RIVEXIS_ALERT_WORKER_DATABASE_URL=
RIVEXIS_ALERT_WORKER_ROLE=
RIVEXIS_ALLOWED_ORIGINS=http://localhost:3000
ENABLE_DEMO_ADAPTER=false
# P34 browser/session and identity controls. Production requires direct email member add OFF,
# exact HTTPS origins, PostgreSQL-backed login throttling and distributed provider controls.
RIVEXIS_SESSION_COOKIE_NAME=rivexis_session
RIVEXIS_SESSION_COOKIE_SAMESITE=lax
RIVEXIS_ALLOW_DIRECT_ORG_MEMBER_ADD=true
RIVEXIS_MEMBERSHIP_CLAIM_TTL_SECONDS=900
# memory for local development; postgres (preferred on Supabase) or redis for production.
RIVEXIS_AUTH_RATE_LIMIT_BACKEND=memory
RIVEXIS_AUTH_LOGIN_ATTEMPTS_PER_MINUTE=20
# P35 global distributed pre-scrypt budget blocks rotating-identifier CPU abuse.
RIVEXIS_AUTH_GLOBAL_ATTEMPTS_PER_MINUTE=300
NEXT_PUBLIC_RIVEXIS_API_URL=http://localhost:8000
# Provider credentials — leave blank if unavailable. Never commit real values.
DUNE_API_KEY=
ETHERSCAN_API_KEY=
ALCHEMY_API_KEY=
QUICKNODE_URL=
QUICKNODE_URL_TEMPLATE=
ETHEREUM_RPC_URL=
BASE_RPC_URL=
ARBITRUM_RPC_URL=
OPTIMISM_RPC_URL=
POLYGON_RPC_URL=
RIVEXIS_PROVIDER_TIMEOUT_SECONDS=8
TENDERLY_ACCESS_KEY=
TENDERLY_ACCOUNT=
TENDERLY_PROJECT=
BLOCKAID_API_KEY=
HYPERNATIVE_API_KEY=
LIFI_API_KEY=
NANSEN_API_KEY=
ARKHAM_API_KEY=
COINGECKO_API_KEY=
COINMARKETCAP_API_KEY=
KAIKO_API_KEY=
GLASSNODE_API_KEY=
TOKEN_TERMINAL_API_KEY=
MESSARI_API_KEY=
GAUNTLET_API_KEY=
CHAOS_LABS_API_KEY=
THEGRAPH_API_KEY=

# Provider runtime controls (production requires the shared PostgreSQL or Redis control plane)
RIVEXIS_PROVIDER_CALLS_PER_MINUTE=120
RIVEXIS_PROVIDER_MAX_RETRIES=2
RIVEXIS_PROVIDER_RETRY_BASE_SECONDS=0.05
RIVEXIS_PROVIDER_RETRY_MAX_SECONDS=0.5
RIVEXIS_PROVIDER_CIRCUIT_FAILURE_THRESHOLD=4
RIVEXIS_PROVIDER_CIRCUIT_COOLDOWN_SECONDS=30
RIVEXIS_PROVIDER_REST_CACHE_TTL_SECONDS=15

# P4 provider runtime control plane
# memory for local development; postgres (preferred on Supabase) or redis for production.
RIVEXIS_PROVIDER_CONTROL_BACKEND=memory
REDIS_URL=
RIVEXIS_PROVIDER_ESTIMATED_COST_USD_PER_ATTEMPT=0
# Example per-provider override:
# RIVEXIS_PROVIDER_ALCHEMY_ESTIMATED_COST_USD_PER_ATTEMPT=0
# ORM create_all is SQLite-only. PostgreSQL/production startup hard-refuses auto-create and must use the one-shot Alembic migration job.
RIVEXIS_AUTO_CREATE_SCHEMA=false
# Optional staging-only RLS certification URLs (do not commit credentials).
RIVEXIS_RLS_ADMIN_DATABASE_URL=
RIVEXIS_RLS_APP_DATABASE_URL=
RIVEXIS_RLS_WORKER_DATABASE_URL=

# P5 credentialed security/entity integrations
# Blockaid supports either BLOCKAID_API_KEY or the SDK-native BLOCKAID_CLIENT_API_KEY.
BLOCKAID_CLIENT_API_KEY=
BLOCKAID_BASE_URL=https://api.blockaid.io
NANSEN_BASE_URL=https://api.nansen.ai
ARKHAM_BASE_URL=https://api.arkm.com
# Do not enable Arkham merely because a key exists. Confirm the deployment's API/commercial terms first.
RIVEXIS_ARKHAM_LICENSE_APPROVED=false
# Hypernative customer schemas are access-controlled; Rivexis will not invent an endpoint/payload contract.
HYPERNATIVE_BASE_URL=

# P5 staging certification (optional locally; can be required in deployment pipelines)
RIVEXIS_CERTIFICATION_ADDRESS=
RIVEXIS_CERTIFICATION_CHAIN=ethereum
RIVEXIS_REQUIRE_LIVE_PROVIDER_CERTIFICATION=false
RIVEXIS_REQUIRE_REDIS_CERTIFICATION=false

# Rivexis-owned ingress secret for customer-configured Hypernative webhook forwarding.
HYPERNATIVE_WEBHOOK_SECRET=

# Durable alert delivery / B3 escalation sink
# P34: with RIVEXIS_ENV=production/prod, URL must be HTTPS and HMAC secret is mandatory.
# URL userinfo/query/fragment components are rejected. Signatures bind X-Rivexis-Timestamp + canonical body.
# Unsigned HTTP is development-only.
RIVEXIS_ALERT_WEBHOOK_URL=
# Production global sink is permitted only as a Rivexis-controlled multi-tenant gateway.
RIVEXIS_ALERT_WEBHOOK_SCOPE=
RIVEXIS_ALERT_WEBHOOK_SECRET=
RIVEXIS_ALERT_MAX_ATTEMPTS=5
RIVEXIS_ALERT_RETRY_BASE_SECONDS=30
RIVEXIS_ALERT_WEBHOOK_TIMEOUT_SECONDS=8
RIVEXIS_ALERT_SLO_SECONDS=300
RIVEXIS_ALERT_WORKER_POLL_SECONDS=5
RIVEXIS_ALERT_WORKER_BATCH_SIZE=50
RIVEXIS_ALERT_WORKER_WORKSPACE_LIMIT=100

# Protocol-adapter staging certification (non-secret target addresses/IDs)
RIVEXIS_REQUIRE_PROTOCOL_ADAPTER_CERTIFICATION=false
RIVEXIS_CERTIFICATION_CHAIN=ethereum
RIVEXIS_CERT_AT_BLOCK=
RIVEXIS_CERT_AAVE_CHAIN=
RIVEXIS_CERT_AAVE_DATA_PROVIDER=
RIVEXIS_CERT_AAVE_ASSET=
RIVEXIS_CERT_AAVE_POOL=
RIVEXIS_CERT_AAVE_USER=
RIVEXIS_CERT_COMPOUND_CHAIN=
RIVEXIS_CERT_COMPOUND_COMET=
RIVEXIS_CERT_COMPOUND_MARKET=usdc
RIVEXIS_CERT_COMPOUND_ASSET=
RIVEXIS_CERT_COMPOUND_USER=
RIVEXIS_CERT_MORPHO_CHAIN=
RIVEXIS_CERT_MORPHO_MARKET_ID=
RIVEXIS_CERT_MORPHO_CONTRACT=
RIVEXIS_CERT_MORPHO_USER=

# P10 historical protocol event/configuration controls and staging certification
RIVEXIS_PROTOCOL_HISTORY_MAX_BLOCKS=50000
RIVEXIS_PROTOCOL_HISTORY_CHUNK_BLOCKS=5000
RIVEXIS_PROTOCOL_HISTORY_MIN_CHUNK_BLOCKS=25
RIVEXIS_PROTOCOL_HISTORY_TIMESTAMP_MAX_BLOCKS=250
RIVEXIS_REQUIRE_PROTOCOL_HISTORY_CERTIFICATION=false
RIVEXIS_CERT_HISTORY_ADAPTER=
RIVEXIS_CERT_HISTORY_CHAIN=
RIVEXIS_CERT_HISTORY_FROM_BLOCK=
RIVEXIS_CERT_HISTORY_TO_BLOCK=
# Aave: reserve asset; Compound: collateral asset; Morpho: market ID bytes32.
RIVEXIS_CERT_HISTORY_SUBJECT=
RIVEXIS_CERT_HISTORY_MARKET=usdc

# P10 upstream deployment-registry certification (run only in a network-enabled controlled release job)
RIVEXIS_CERTIFY_REGISTRY_UPSTREAM=false
RIVEXIS_REGISTRY_CERT_TIMEOUT_SECONDS=15

# P11 Morpho dependency economics / feed freshness
RIVEXIS_MORPHO_FEED_STALE_SECONDS=3600

# P11 retention policy. Reports are indefinite by default (0 = disabled retention).
RIVEXIS_RETENTION_PROVIDER_REQUESTS_DAYS=90
RIVEXIS_RETENTION_AUDIT_LOGS_DAYS=365
RIVEXIS_RETENTION_REPORTS_DAYS=0
# Destructive cleanup requires an approved maintenance window and explicit opt-in.
RIVEXIS_RETENTION_ALLOW_DELETE=false
RIVEXIS_RETENTION_ALLOW_REPORT_DELETE=false

# P11 backup/restore certification. Restore URL must point at a disposable target.
RIVEXIS_BACKUP_SOURCE_DATABASE_URL=
RIVEXIS_BACKUP_RESTORE_DATABASE_URL=
RIVEXIS_BACKUP_RESTORE_ALLOW_APPLY=false
RIVEXIS_BACKUP_MAX_RTO_SECONDS=900

# P35 OpenTelemetry OTLP export (disabled by default). Production remote collectors require HTTPS; loopback HTTP is allowed for a local sidecar.
RIVEXIS_OTEL_ENABLED=false
RIVEXIS_OTEL_SYNC_EXPORT=false
RIVEXIS_RELEASE_VERSION=3.4.3
OTEL_SERVICE_NAME=rivexis-api
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_EXPORTER_OTLP_TRACES_HEADERS=

# P31 distributed Redis certification tuning
RIVEXIS_REDIS_CERT_WORKERS=8
RIVEXIS_REDIS_CERT_BUDGET=40
RIVEXIS_REDIS_CERT_ATTEMPTS=80
RIVEXIS_REDIS_MAX_P95_MS=

# P37 certification strictness / canonical execution/report output
RIVEXIS_REQUIRE_STAGING_CERTIFICATION=false
RIVEXIS_REQUIRE_DEPENDENCY_CERTIFICATION=false
# Must point to the canonical repository-root P37 manifest when explicitly set.
RIVEXIS_CERT_EXECUTION_MANIFEST=certification-execution-manifest.json
# Must match the selected profile path emitted by the P37 execution manifest.
RIVEXIS_STAGING_CERT_REPORT=

# P37 multi-run release certification bundle
RIVEXIS_CERT_INPUT_REPORTS=
RIVEXIS_RELEASE_CERT_BUNDLE=

# P37 runner-profile-bound certification. Use one explicit profile per controlled runner.
# Profiles: local, postgres-rls, postgres-dr, redis, registry, providers, protocol, history, dependencies, full
RIVEXIS_CERT_RUNNER_PROFILE=local
# Optional operator/CI label; this is sealed metadata, not a cryptographic identity.
RIVEXIS_CERT_RUNNER_ID=
